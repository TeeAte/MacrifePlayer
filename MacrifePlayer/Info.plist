<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Macrife Player</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.yingyejiulimeng.macrifeplayer</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleName</key>
	<string>Macrife Player</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.0</string>
	<key>CFBundleVersion</key>
	<string>0.4.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSCameraUsageDescription</key>
	<string>Macrife Player 需要访问摄像头或采集卡视频设备，用于实时预览、播放和补帧。</string>
	<key>NSCameraUseContinuityCameraDeviceType</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Macrife Player 需要访问麦克风或采集卡音频设备，用于实时音频播放和音画同步。</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Macrife Player 需要屏幕录制权限，用于采集其他程序窗口画面并进行实时播放和补帧。</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video Media File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<!--
			  LSItemContentTypes 是新版 LaunchServices 的唯一可靠依据。
			  只给 CFBundleTypeExtensions 时，claim 在老系统上还能靠扩展名兜住，
			  但 macOS 26 起系统是按 UTI 判定的：缺这一节就会出现
			  「声明了能打开、Finder 却说打不开」的半吊子状态。
			  扩展名一节保留，兼容仍在用 legacy 匹配的调用方。
			-->
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mpeg-4</string>
				<string>com.apple.m4v-video</string>
				<string>com.apple.quicktime-movie</string>
				<string>public.mpeg-2-transport-stream</string>
				<string>public.avchd-mpeg-2-transport-stream</string>
				<string>public.avi</string>
				<string>org.matroska.mkv</string>
				<string>org.webmproject.webm</string>
				<string>com.adobe.flash.video</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>mts</string>
				<string>m2ts</string>
				<string>ts</string>
				<string>mp4</string>
				<string>mov</string>
				<string>mkv</string>
				<string>avi</string>
				<string>m4v</string>
				<string>webm</string>
				<string>flv</string>
			</array>
		</dict>
	</array>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
